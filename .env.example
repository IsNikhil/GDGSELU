# Board inbox (gdgselu.com/inbox). Copy to .env.local for local development, and add the
# same names in Vercel > Project > Settings > Environment Variables for production.
# Never commit real values. See docs/inbox-setup.md.

# Resend API key with FULL ACCESS (needed to read received email). Starts with re_
RESEND_API_KEY=

# Sender for replies and sign in codes. Must be on your verified Resend domain.
INBOX_FROM=GDG Southeastern <info@gdgselu.com>

# Random secret, at least 32 characters. Generate with: openssl rand -base64 36
# Changing it signs everyone out.
INBOX_SESSION_SECRET=

# Board members who may sign in, comma separated.
INBOX_ALLOWED_EMAILS=
